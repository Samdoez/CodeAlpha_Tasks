<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Urbanist:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/index.css">
    <title>Samuel Event Registration system</title>
</head>
<body>
  <div class="main-cont flex">
        <h1 class="text">Welcome to Samuel <br/>Events Registration System</h1>
        <p class="red">Admin Login</p>
        
        <div class="reg-cont flex">
              <form class="form-flex flex" action="/adminloginUser" method="post" autocomplete="off">
                <div>
                    <label for="email">Email</label> <br/>
                    <input type="email" name="email" id="email" placeholder="enter your email"required autocomplete="off"> 
                </div>
               
                <div>
                    <label for="password">Password</label> <br/>
                    <input type="password" name="password" id="password" placeholder="password"required autocomplete="off">
                </div>
            
                <button type="submit" class="btn-link">Login</button>
            </form>
            
            <p style="color: red;">
                <% if (locals.error) { %>
                    <p class="error-message red"><%= error %></p>
            <% } %>
            </p>
        </div>
</body>
</html>